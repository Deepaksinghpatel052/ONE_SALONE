# Copy to frontend/.env and fill in real values. Never commit frontend/.env.

# Public URL of the FastAPI backend (no trailing slash, without /api)
REACT_APP_BACKEND_URL=http://localhost:8001
# Dev-server websocket port (443 when served behind an HTTPS proxy)
WDS_SOCKET_PORT=0
# Enable the webpack health-check plugin (true/false)
ENABLE_HEALTH_CHECK=false
