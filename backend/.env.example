# Copy to backend/.env and fill in real values. Never commit backend/.env.

# MongoDB connection string
MONGO_URL="mongodb://localhost:27017"
# Database name (use a dedicated name in production, not test_database)
DB_NAME="onesalon"
# Comma-separated list of allowed frontend origins, e.g. https://onesalon.in
CORS_ORIGINS="http://localhost:3000"
# Secret key protecting GET /api/bookings?key=... — use a long random string
ADMIN_KEY="change-me-to-a-long-random-string"
