# Docker Compose settings. Copy to .env (next to docker-compose.yml) and fill in.

# Secret key protecting GET /api/bookings?key=... — use a long random string
ADMIN_KEY=change-me-to-a-long-random-string
# MongoDB database name
DB_NAME=onesalon
# Allowed browser origins for the API (comma-separated)
CORS_ORIGINS=http://localhost:8080
# Leave empty to serve the API from the same domain via nginx (/api)
REACT_APP_BACKEND_URL=

# ---- Ports ----
# Website (nginx) on the host -> http://localhost:8080
WEB_PORT=8080
# Backend API port (inside Docker and on the host) -> http://localhost:8001/api/
BACKEND_PORT=8001
# MongoDB port on the host (localhost only, for tools like MongoDB Compass)
MONGO_PORT=27017
